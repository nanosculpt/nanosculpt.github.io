or","children":"PI"}]}],["$","img",null,{"className":"_portrait_1y71c_4","src":"/images/max-birch.png","alt":"Max Birch beside laboratory equipment","width":"1168","height":"800"}],["$","a",null,{"className":"_email_1y71c_7","href":"mailto:maximilian.birch@riken.jp","children":"maximilian.birch@riken.jp"}],["$","a",null,{"className":"_profileLink_1y71c_14","href":"https://warwick.ac.uk/fac/sci/physics/research/condensedmatt/supermag/whoswho/max_birch/","children":"Warwick profile"}]]}],["$","div",null,{"className":"_bio_1y71c_11","children":[["$","p",null,{"children":"From March 2027, Max Birch will be an Assistant Professor and Royal Society University Research Fellow in the Department of Physics at the University of Warwick. His research combines focused ion beam sculpting with electrical transport measurements, complemented by techniques ranging from X-ray and electron microscopy to neutron scattering and more."}],["$","p",null,{"children":"He completed his PhD at Durham University with Prof. Peter Hatton and Dr. Paul Steadman, studying the three dimensional structure of magnetic skyrmions. He subsequently joined Prof. Gisela Schütz’s group at the Max Planck Institute for Intelligent Systems in Stuttgart, investigating magnetic textures and their dynamics, including in van der Waals magnets. At RIKEN’s Center for Emergent Matter Science in Japan, he worked with Prof. Yoshinori Tokura, developing single-crystal FIB devices to explore quantum transport and emergent electromagnetism."}]]}]]}]]}]]}],["$","footer",null,{"children":["$","div",null,{"className":"footer-row","children":["$","span",null,{"children":"Nanosculpted Quantum Materials · Birch Lab · University of Warwick"}]}]}]]]
